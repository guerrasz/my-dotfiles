font-family = JetBrainsMono Nerd Font Mono
background-blur-radius = 20
mouse-hide-while-typing = true
window-decoration = true
theme = Catppuccin Mocha
keybind = super+l=text:clear && fastfetch \n
keybind = super+j=text:export TERM=xterm \n
keybind = super+m=text:cmatrix -sb -u 7 -C magenta \n
keybind = super+;=text:asciiquarium \n
keybind = super+'=text:clear && fastfetch \n task list \n
keybind = super+z=text:task add ""
keybind = super+shift+r=prompt_tab_title
shell-integration-features = no-title
