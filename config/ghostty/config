font-family = JetBrainsMono Nerd Font Mono
background-blur = true
mouse-hide-while-typing = true
window-decoration = true
theme = Catppuccin Mocha
shell-integration-features = no-title,ssh-terminfo,ssh-env
keybind = super+l=text:clear && fastfetch \n
keybind = super+/=text:clear && fastfetch -c ~/.config/fastfetch/claude.jsonc \n
keybind = super+m=text:cmatrix -sb -u 7 -C magenta \n
keybind = super+;=text:asciiquarium \n
keybind = super+'=text:clear && fastfetch \n task list \n
keybind = super+z=text:task add ""
keybind = super+shift+r=prompt_tab_title
shell-integration-features = no-title
background-opacity = 0.95

# gtab managed include
config-file = "/Users/guerra/.config/gtab/ghostty-shortcut.conf"
